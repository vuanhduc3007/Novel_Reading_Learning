{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/index.js"],
      "env": { "PORT": "3000", "TRANSLATION_PROVIDER": "google-free", "DICTIONARY_PROVIDER": "mymemory" },
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5185", "--strictPort"],
      "env": { "VITE_API_BASE_URL": "http://localhost:3000", "VITE_USE_MOCK_API": "false" },
      "port": 5185
    }
  ]
}
